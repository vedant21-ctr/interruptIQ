# Environment Variables Template for InterruptIQ
PORT=3001
NODE_ENV=development

# Postgres Database connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/interrupt_iq?schema=public"

# Redis Distributed Cache & Rate Limiter
REDIS_URL="redis://localhost:6379"

# JWT token signature secret
JWT_SECRET="generate-a-secure-random-token-key-for-production"

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_EVENTS_MAX=120
RATE_LIMIT_DECISION_MAX=60
RATE_LIMIT_RETRIEVAL_MAX=20
RATE_LIMIT_CRITIC_MAX=10

# Reverse Proxy Trust Configuration (false for direct access; true or CIDR string if behind trusted reverse proxy)
TRUST_PROXY=false

# LLM Providers Configuration (Optional)
OPENAI_API_KEY=""
OLLAMA_ENDPOINT="http://localhost:11434"

