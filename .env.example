# Environment Variables Template for InterruptIQ
PORT=3001
NODE_ENV=development

# Postgres Database connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/interrupt_iq?schema=public"

# JWT token signature secret
JWT_SECRET="generate-a-secure-random-token-key-for-production"

# LLM Providers Configuration (Optional)
OPENAI_API_KEY=""
OLLAMA_ENDPOINT="http://localhost:11434"
